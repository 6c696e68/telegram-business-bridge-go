#!/bin/sh /etc/rc.common
# OpenWrt procd init script for tg-bridge (Go build).
# Install: cp to /etc/init.d/tg-business-bridge, chmod +x, enable, start.
START=99
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance bridge
  procd_set_param command /root/tg-business-bridge/bin/tg-bridge -config /root/tg-business-bridge/config.json
  procd_set_param env HOME=/root
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
